.page {
  padding: 24rpx 0 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.hero .hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.hero .name {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
}
.hero .addr {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #8a8f99;
  line-height: 1.5;
}
.hero .fac {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}
.hero .fac-item {
  font-size: 22rpx;
  color: #5a6072;
  background: #f2f3f5;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
}

/* 分区标题（详情/信息通用） */
.sec-t {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2329;
  margin-bottom: 18rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #07c160;
  line-height: 1.2;
}
.sec {
  margin-top: 28rpx;
}

/* 驿站信息：两列网格，松间距 */
.info .grid {
  display: flex;
  flex-wrap: wrap;
}
.info .gi {
  width: 50%;
  box-sizing: border-box;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.info .gi .k {
  font-size: 22rpx;
  color: #8a8f99;
}
.info .gi .v {
  font-size: 28rpx;
  color: #1f2329;
  font-weight: 500;
}
.info .desc {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f0f1f3;
  font-size: 26rpx;
  color: #5a6072;
  line-height: 1.7;
}

.actions {
  display: flex;
  gap: 24rpx;
  margin: 28rpx 24rpx 0;
}
.actions > view {
  flex: 1;
}
.tip {
  margin: 28rpx 24rpx 0;
  font-size: 24rpx;
  color: #8a8f99;
  text-align: center;
  line-height: 1.6;
}
