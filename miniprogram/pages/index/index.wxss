.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}
.map-wrap {
  position: relative;
  flex-shrink: 0;
  min-height: 420rpx;
  height: 40%;
}
.map {
  width: 100%;
  height: 100%;
}
.map-tip {
  position: absolute;
  left: 50%;
  bottom: 16rpx;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}
.tabs {
  display: flex;
  background: #fff;
  border-bottom: 2rpx solid #f0f1f3;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: #8a8f99;
}
.tab.active {
  color: #07c160;
  font-weight: 600;
  position: relative;
}
.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: #07c160;
}
.list {
  flex: 1;
  min-height: 0;
  padding-top: 20rpx;
  box-sizing: border-box;
}
.search {
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 2rpx solid #f0f1f3;
}
.search-input {
  height: 68rpx;
  background: #f5f6f8;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #1a1a1a;
}
.search-ph {
  color: #b0b4bd;
}
.list-title {
  padding: 22rpx 24rpx 6rpx;
  font-size: 26rpx;
  color: #8a8f99;
  background: #f5f6f8;
}

/* 冷启动定位提示弹窗 */
.loc-tip-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 0 56rpx;
}
.loc-tip-card {
  position: relative;
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx 40rpx;
  box-sizing: border-box;
}
.loc-tip-close {
  position: absolute;
  top: 18rpx;
  right: 24rpx;
  font-size: 40rpx;
  line-height: 1;
  color: #c0c4cc;
  padding: 8rpx;
}
.loc-tip-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 20rpx;
}
.loc-tip-emoji {
  margin-right: 6rpx;
}
.loc-tip-body {
  font-size: 27rpx;
  line-height: 1.7;
  color: #4a4f57;
  text-align: justify;
}
.loc-tip-ok {
  margin-top: 32rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
}
