<view class="page">
  <view class="card">
    <view class="label">反馈类型</view>
    <view class="kinds">
      <view class="kind {{kind==='suggestion'?'on':''}}" data-kind="suggestion" bindtap="chooseKind">建议</view>
      <view class="kind {{kind==='issue'?'on':''}}" data-kind="issue" bindtap="chooseKind">问题</view>
      <view class="kind {{kind==='praise'?'on':''}}" data-kind="praise" bindtap="chooseKind">表扬</view>
    </view>

    <view class="label">反馈内容</view>
    <textarea
      class="textarea"
      placeholder="例如：驿站空调坏了 / 希望增加饮水点 / 感谢志愿者…"
      maxlength="500"
      data-field="message"
      bindinput="onInput"
      value="{{message}}"
    ></textarea>
    <view class="counter">{{message.length}}/500</view>

    <view class="privacy">本反馈为匿名提交，不收集任何个人联系方式，仅用于驿站优化。</view>
  </view>

  <button class="btn-primary submit" bindtap="onSubmit" disabled="{{submitting}}">
    {{submitting ? '提交中…' : '提交反馈'}}
  </button>
</view>
