.page {
  padding: 24rpx 0 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.label {
  font-size: 26rpx;
  color: #8a8f99;
  margin: 8rpx 0 12rpx;
}
.kinds {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.kind {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: #f2f3f5;
  color: #5a6072;
  font-size: 26rpx;
}
.kind.on {
  background: #e7f7ee;
  color: #07c160;
  font-weight: 600;
}
.textarea {
  width: 100%;
  height: 220rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}
.counter {
  text-align: right;
  font-size: 22rpx;
  color: #b2b6bf;
  margin-top: 6rpx;
}
.privacy {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #b2b6bf;
}
.submit {
  margin: 36rpx 24rpx 0;
}
